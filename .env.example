# Copy to .env and fill in, then: set -a; source .env; set +a

# Supabase dashboard -> Connect -> "Session pooler" connection string (works over IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co

# Random strings. Set the same values as function secrets:
#   supabase secrets set EMBED_SECRET=... MCP_PATH_SECRET=...
EMBED_SECRET=change-me
MCP_PATH_SECRET=change-me
